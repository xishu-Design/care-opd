{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuardTCM Quiz",
  "type": "object",
  "required": ["quiz_id", "case_id", "question_type", "question", "options", "answer", "explanation", "knowledge_points", "source_id"],
  "properties": {
    "quiz_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "question_type": { "type": "string" },
    "question": { "type": "string", "minLength": 1 },
    "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "answer": { "type": ["string", "boolean"] },
    "explanation": { "type": "string", "minLength": 1 },
    "knowledge_points": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "source_id": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
