{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuardTCM Content Source",
  "type": "object",
  "required": ["source_id", "source_title", "source_type", "source_version", "source_year", "evidence_level", "license_note"],
  "properties": {
    "source_id": { "type": "string", "minLength": 1 },
    "source_title": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "minLength": 1 },
    "source_version": { "type": "string" },
    "source_year": { "type": "string" },
    "evidence_level": { "type": "string", "minLength": 1 },
    "license": { "type": "string" },
    "license_note": { "type": "string", "minLength": 1 },
    "repository_url": { "type": "string" },
    "processing_script": { "type": "string" },
    "processing_version": { "type": "string" }
  },
  "additionalProperties": true
}
