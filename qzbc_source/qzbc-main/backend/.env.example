# 稳定演示默认值
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-random-local-secret
# 生产环境必须改为明确的前端域名列表，不能使用 *
CORS_ORIGINS=["*"]
LLM_PROVIDER=template
KNOWLEDGE_BACKEND=local_knowledge
GRAPH_BACKEND=graphiti
MEMORY_BACKEND=mem0
LIGHTRAG_ENABLED=false
LIGHTRAG_MODE=api
LLM_ALLOW_FALLBACK=true
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_SEED=42
LLM_MAX_INPUT_TOKENS=6000
LLM_MAX_OUTPUT_TOKENS=1200
LIGHTRAG_ALLOW_FALLBACK=true
QA_KNOWLEDGE_ENABLED=true
QA_KNOWLEDGE_INDEX_PATH=runtime/qa_knowledge/qa_index.db
QA_KNOWLEDGE_CANDIDATE_LIMIT=30
QA_KNOWLEDGE_RERANK_ENABLED=true
QA_KNOWLEDGE_RERANK_LIMIT=8
GRAPHITI_DB_PATH=runtime/graphiti/guardtcm.db
GRAPHITI_DATABASE=guardtcm
GRAPHITI_GROUP_PREFIX=guardtcm
GRAPHITI_TELEMETRY_ENABLED=false
MEM0_DIR=runtime/mem0/meta
MEM0_QDRANT_PATH=runtime/mem0/qdrant
MEM0_HISTORY_DB_PATH=runtime/mem0/history.db
MEM0_SEARCH_TOP_K=8
MEM0_MIN_RELEVANCE_SCORE=0.55
MEM0_TELEMETRY=false
CONVERSATION_CONTEXT_ENABLED=true
CONVERSATION_RECENT_TURNS=6
CONVERSATION_CONTEXT_MAX_CHARS=6000
CONVERSATION_QUESTION_MAX_CHARS=600
CONVERSATION_ANSWER_MAX_CHARS=1200

# PRIVATE 三角色受控评测专用门禁。默认必须关闭；不要在正常产品环境启用。
PRIVATE_EVAL_EVIDENCE_CONTROL_ENABLED=false
PRIVATE_EVAL_EVIDENCE_CONTROL_SECRET=
PRIVATE_EVAL_ISOLATED_DATABASE_ACK=

# 本地真实模式时覆盖为以下值
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_NUM_CTX=32768
LIGHTRAG_API_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=replace-with-a-random-local-secret
LIGHTRAG_WORKING_DIR=runtime/lightrag/active/current
LIGHTRAG_INPUT_DIR=runtime/lightrag/active/input
