HOST=127.0.0.1
PORT=9621
LIGHTRAG_API_KEY=replace-with-a-random-local-secret
WORKING_DIR=../../runtime/lightrag/active/current
INPUT_DIR=../../runtime/lightrag/active/input

LLM_BINDING=ollama
LLM_MODEL=qwen2.5:7b
LLM_BINDING_HOST=http://127.0.0.1:11434
OLLAMA_LLM_NUM_CTX=32768
OLLAMA_LLM_NUM_PREDICT=2048

EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BINDING_HOST=http://127.0.0.1:11434
EMBEDDING_DIM=1024
EMBEDDING_BATCH_NUM=4

SUMMARY_LANGUAGE=Chinese
ENABLE_LLM_CACHE=true
MAX_ASYNC=1
MAX_ASYNC_LLM=1
EMBEDDING_FUNC_MAX_ASYNC=1
MAX_PARALLEL_INSERT=1
LLM_TIMEOUT=300
EMBEDDING_TIMEOUT=180
OLLAMA_EMBEDDING_NUM_CTX=8192
